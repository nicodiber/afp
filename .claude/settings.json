{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git merge * main*)",
      "Bash(gh pr create * --base main*)",
      "Bash(gh api *pulls*base=main*)",
      "Read(//home/claude/datos-aep/v3-nuevo/**)",
      "Edit(//home/claude/datos-aep/v3-nuevo/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-al-editar.mjs\"" }]
      }
    ]
  }
}
